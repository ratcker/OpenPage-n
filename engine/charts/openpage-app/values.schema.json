{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenPage Engine release values",
  "description": "Inputs produced by Manifest Generator from an approved release snapshot.",
  "type": "object",
  "required": ["project", "services", "routes", "gateway"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "hostname", "sourceSHA", "configRevision"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable project UUID. Used in resource names and pod selectors.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "hostname": {
          "description": "Hostname assigned by the platform, in ASCII DNS form (Punycode for internationalized names).",
          "allOf": [
            {"$ref": "#/definitions/dnsName"},
            {"pattern": "\\.", "not": {"pattern": "^[0-9]+(\\.[0-9]+){3}$"}}
          ]
        },
        "sourceSHA": {
          "type": "string",
          "description": "Source commit fixed by the release.",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "configRevision": {
          "type": "string",
          "description": "Opaque identifier of the immutable configuration snapshot used by the release.",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "object",
      "description": "All application services in the release, keyed by stable service name.",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/serviceName"},
      "additionalProperties": {"$ref": "#/definitions/service"}
    },
    "routes": {
      "type": "array",
      "description": "Public HTTP path prefixes mapped to keys in services. Prefixes are forwarded unchanged.",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["path", "service"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+/)*([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*$",
            "not": {"pattern": "/\\.{1,2}(/|$)|%2[fF]"}
          },
          "service": {"$ref": "#/definitions/serviceName"}
        }
      }
    },
    "gateway": {
      "type": "object",
      "description": "Reference to an existing platform Gateway, required when routes are present.",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/definitions/dnsName"},
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    }
  },
  "if": {"properties": {"routes": {"minItems": 1}}},
  "then": {"properties": {"gateway": {"required": ["name", "namespace"]}}},
  "definitions": {
    "dnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "serviceName": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "quantity": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
    },
    "resourceList": {
      "type": "object",
      "required": ["cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "cpu": {"$ref": "#/definitions/quantity"},
        "memory": {"$ref": "#/definitions/quantity"}
      }
    },
    "service": {
      "type": "object",
      "required": ["image", "replicas", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "description": "Fully qualified OCI image reference pinned by the release digest.",
          "pattern": "^((([a-zA-Z0-9-]+\\.)+[a-zA-Z0-9-]+|localhost)(:[0-9]+)?|[a-zA-Z0-9-]+:[0-9]+|\\[[0-9a-fA-F:]+\\](:[0-9]+)?)(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)+(:[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127})?@(sha256:[0-9a-f]{64}|sha384:[0-9a-f]{96}|sha512:[0-9a-f]{128})$"
        },
        "replicas": {
          "type": "integer",
          "description": "Desired replica count. Zero suspends the service while retaining its configuration.",
          "minimum": 0,
          "maximum": 2147483647
        },
        "port": {
          "description": "Declared container port. When set, the chart creates a ClusterIP Service.",
          "allOf": [{"$ref": "#/definitions/port"}]
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "additionalProperties": false,
          "properties": {
            "requests": {"$ref": "#/definitions/resourceList"},
            "limits": {"$ref": "#/definitions/resourceList"}
          }
        },
        "env": {
          "type": "object",
          "description": "Plaintext environment variables. Secret values must never be placed here.",
          "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "readinessProbe": {"$ref": "#/definitions/readinessProbe"}
      }
    },
    "readinessProbe": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["httpGet"]},
        {"required": ["tcpSocket"]},
        {"required": ["grpc"]},
        {"required": ["exec"]}
      ],
      "properties": {
        "httpGet": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "port": {"$ref": "#/definitions/port"},
            "path": {"type": "string", "pattern": "^/"},
            "scheme": {"enum": ["HTTP", "HTTPS"]},
            "httpHeaders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "value": {"type": "string"}
                }
              }
            }
          }
        },
        "tcpSocket": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {"port": {"$ref": "#/definitions/port"}}
        },
        "grpc": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "port": {"$ref": "#/definitions/port"},
            "service": {"type": "string"}
          }
        },
        "exec": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "successThreshold": {"type": "integer", "minimum": 1}
      }
    }
  }
}
