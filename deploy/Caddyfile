xn--e1aamodgc0e.xn--p1ai {
	route {
		@private_docs path /api/docs* /api/schema* /api/redoc*
		respond @private_docs 404

		@bookUpload {
			method POST
			path /api/knowledge/books/
		}
		request_body @bookUpload {
			max_size 90MiB
		}

		handle /api/* {
			reverse_proxy backend:8000
		}

		handle {
			reverse_proxy frontend:8080
		}
	}
}

s3.xn--e1aamodgc0e.xn--p1ai {
	reverse_proxy minio:9000
}

:8081 {
	handle_path /static/* {
		root * /srv/django-static
		file_server
	}

	handle /admin* {
		reverse_proxy backend:8000
	}

	handle /api/docs* {
		reverse_proxy backend:8000
	}

	handle /api/schema* {
		reverse_proxy backend:8000
	}

	handle /api/redoc* {
		reverse_proxy backend:8000
	}

	handle {
		respond "Not found" 404
	}
}